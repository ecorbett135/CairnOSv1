ARG RELEASE_PLATFORM=linux/amd64
FROM --platform=${RELEASE_PLATFORM} python:3.11.15-slim-bookworm@sha256:28255a3ace7eb4c48bc1b57b90af29e1bc82b4fd6c60614a8e3dce61b87ff941

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

WORKDIR /app

COPY requirements.api.txt /app/requirements.api.txt
RUN python -m pip install --no-cache-dir -r /app/requirements.api.txt

COPY . /app

EXPOSE 8010

CMD ["uvicorn", "cairn.api.asgi_app:app", "--host", "0.0.0.0", "--port", "8010"]
